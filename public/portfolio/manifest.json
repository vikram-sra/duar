    {
      "id": "Narm Androon",
      "file": "Narm Androon.jpg",
      "webp": "Narm Androon.webp",
      "mid": "mid/Narm Androon.webp",
      "midJpg": "mid/Narm Androon.jpg",
      "thumb": "thumbs/Narm Androon.webp",
      "thumbJpg": "thumbs/Narm Androon.jpg",
      "width": 1821,
      "height": 3580,
      "aspect": 0.5087,
      "heightIn": 26,
      "widthIn": 13.23,
      "measured": true,
      "title": "\u0a28\u0a30\u0a2e \u0a05\u0a70\u0a26\u0a30\u0a42\u0a28 / Narm Androon",
      "year": 2025,
      "medium": "Oil on canvas",
      "description": "The conclusion of this series served as a passage into the shapeless. It gives character to the moments where we stop fixating on the 'forms' of what we feel and instead embrace the soft, undefined nature of the soul. To step 'indoors' is to move past the threshold of ceremony or performance and into a state of pure presence. Here, the weight of the stone and the sincerity of the heart become one; there is no need for a seen outline when the invisible is felt so clearly.",
      "v": "fb31fcf7",
      "rank": 1,
