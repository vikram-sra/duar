# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Camera originals for the portfolio (104MB). Only the resized copies in
# public/portfolio/ are served and committed — regenerate with: npm run portfolio.
# Leading slash matters: a bare "portfolio/" would also ignore public/portfolio/.
/portfolio/
scripts/__pycache__/

# Raw 3D source downloads (the neem alone is 352MB of scene.bin). Same reasoning
# as /portfolio/ above: only the built .glb in public/models is served, and
# scripts/build-neem-glb.py regenerates it from these on demand.
/3d assets/

# Optimiser output. Intermediates, not sources -- scripts/optimize-forest-glb.py
# rebuilds them in seconds, and committing two copies of each (public + docs)
# adds ~22MB for files nothing currently loads.
*.opt.glb
